extends ../layout

block content
  .page-head
    div
      p.page-kicker Director de obra
      h1.page-title Solicitud de materiales
      p.page-lead Selecciona una partida presupuestaria y prepara una solicitud clara para logistica o administracion.
    .actions
      a.btn.btn--ghost(href=obraId ? `/obras/${obraId}` : "/obras") Volver al detalle

  .panel
    .panel__header
      div
        h2.panel__title Partida y materiales
        p.panel__text Los subitems sugeridos ayudan a ordenar la solicitud segun el rubro elegido.
      span.tag.tag--ochre Vista preparada

    .panel__body
      form#formMateriales.form
        input(type="hidden" id="obraId" name="obraId" value=obraId)

        .field
          label(for="partida") Partida presupuestaria
          select(id="partida" name="partida" required)
            option(value="") Seleccionar partida
            if partidas && partidas.length
              each partida in partidas
                option(value=partida.rubro data-partida-id=partida.id)= partida.rubro
            else
              option(value="trabajos_preliminares_y_gestion_verde") Trabajos preliminares y gestion verde
              option(value="infraestructura_y_fundaciones") Infraestructura y fundaciones
              option(value="envolvente_sustentable") Envolvente sustentable
              option(value="aberturas_de_alta_prestacion") Aberturas de alta prestacion
              option(value="instalaciones_bio_eficientes") Instalaciones bio-eficientes
              option(value="revestimientos_y_terminaciones") Revestimientos y terminaciones
              option(value="limpieza_y_entrega") Limpieza y entrega

        .panel
          .panel__header
            div
              h2.panel__title Materiales / subitems asociados
              p.panel__text Marca los materiales requeridos e indica cantidad, unidad y observaciones.
          .panel__body
            div#subitemsContainer
              .empty-state
                p Selecciona una partida para ver materiales sugeridos.

        .field
          label(for="observaciones") Observaciones para logistica
          textarea(id="observaciones" name="observaciones" rows="4" placeholder="Aclaraciones de entrega, prioridad, proveedor sugerido o restricciones de obra.")

        .form-actions
          button.btn(type="button" id="guardarSolicitudBtn") Guardar solicitud
          a.btn.btn--ghost(href=obraId ? `/obras/${obraId}` : "/obras") Cancelar

  script.
    const partidaSelect = document.getElementById('partida');
    const subitemsContainer = document.getElementById('subitemsContainer');

    const subitemsPorPartida = {
      trabajos_preliminares_y_gestion_verde: [
        'Gestion y permisos',
        'Estudios tecnicos',
        'Ingenieria SIP/Steel',
        'Infraestructura provisoria'
      ],
      infraestructura_y_fundaciones: [
        'Movimiento de suelos',
        'Hormigon elaborado',
        'Hierro y armadura',
        'Barrera de vapor y aislacion',
        'Mano de obra fundaciones'
      ],
      envolvente_sustentable: [
        'Kit de paneles SIP/Steel',
        'Fijaciones y conectores',
        'Kit de hermeticidad',
        'Estructura de cubierta',
        'Mano de obra de montaje'
      ],
      aberturas_de_alta_prestacion: [
        'Carpinteria PVC con RPT',
        'Paquetes de vidrio DVH/TVH',
        'Puertas tecnicas',
        'Instalacion y calibracion'
      ],
      instalaciones_bio_eficientes: [
        'Equipos de climatizacion',
        'Material sanitario y solar',
        'Material electrico y domotica',
        'Mano de obra de instalaciones'
      ],
      revestimientos_y_terminaciones: [
        'Revestimientos exteriores',
        'Terminaciones interiores',
        'Pinturas y revoques EIFS',
        'Mano de obra de acabados'
      ],
      limpieza_y_entrega: [
        'Gestion de residuos',
        'Limpieza de obra'
      ]
    };

    partidaSelect.addEventListener('change', function () {
      const partida = this.value;
      subitemsContainer.innerHTML = '';

      if (!partida) {
        subitemsContainer.innerHTML = '<div class="empty-state"><p>Selecciona una partida para ver materiales sugeridos.</p></div>';
        return;
      }

      const subitems = subitemsPorPartida[partida] || [];

      if (!subitems.length) {
        subitemsContainer.innerHTML = '<div class="empty-state"><p>No hay subitems sugeridos para esta partida.</p></div>';
        return;
      }

      let html = '<div class="grid grid--2">';
      subitems.forEach((subitem, index) => {
        html += `
          <div class="material-card">
            <h4>
              <label>
                <input type="checkbox" name="subitem_check_${index}" value="${subitem}">
                ${subitem}
              </label>
            </h4>
            <div class="form-grid">
              <div class="field">
                <label for="cantidad_${index}">Cantidad</label>
                <input id="cantidad_${index}" type="number" name="cantidad_${index}" min="0" placeholder="0">
              </div>
              <div class="field">
                <label for="unidad_${index}">Unidad</label>
                <input id="unidad_${index}" type="text" name="unidad_${index}" placeholder="m2, bolsas, unidades">
              </div>
              <div class="field field--full">
                <label for="observacion_${index}">Observaciones</label>
                <input id="observacion_${index}" type="text" name="observacion_${index}" placeholder="Detalle opcional">
              </div>
            </div>
          </div>
        `;
      });
      html += '</div>';

      subitemsContainer.innerHTML = html;
    });

    document.getElementById('guardarSolicitudBtn').addEventListener('click', function () {
      const partida = partidaSelect.value;

      if (!partida) {
        alert('Por favor selecciona una partida presupuestaria');
        return;
      }

      alert('Vista de solicitud de materiales preparada. Falta conectar el guardado con el backend.');
    });
