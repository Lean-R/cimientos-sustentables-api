extends ../layout

block content
  .page-head
    div
      p.page-kicker Presupuesto de obra
      h1.page-title#titulo Nueva partida presupuestaria
      p.page-lead#descripcion Cargue rubros e ítems para construir el presupuesto calculado de la obra.

  .panel
    .panel__header
      div
        h2.panel__title Datos de la partida
        p.panel__text Cada partida agrupa ítems con cantidad, unidad y precio unitario.
      span.tag.tag--ochre Etapa clave

    .panel__body
      input(type="hidden" id="obraId" value=obraId)
      input(type="hidden" id="partidaId" value=partidaId)

      .form
        .field
          label(for="rubro") Rubro
          select(id="rubro" required)
            option(value="") Seleccionar rubro
            option(value="trabajos_preliminares_y_gestion_verde") Trabajos preliminares y gestion verde
            option(value="infraestructura_y_fundaciones") Infraestructura y fundaciones
            option(value="envolvente_sustentable") Envolvente sustentable
            option(value="aberturas_de_alta_prestacion") Aberturas de alta prestación
            option(value="instalaciones_bio_eficientes") Instalaciones bio-eficientes
            option(value="revestimientos_y_terminaciones") Revestimientos y terminaciones
            option(value="limpieza_y_entrega") Limpieza y entrega

        .panel
          .panel__header
            div
              h2.panel__title Ítems de la partida
              p.panel__text Agregue los trabajos, materiales o servicios que componen el rubro.
            button.btn.btn--secondary(type="button" id="agregarItemBtn") + Agregar ítem
          .panel__body
            .item-list#itemsContainer
            .empty-state#emptyItems
              p Todavia no agregó ítems. Use el boton "Agregar ítem" para comenzar.

        .form-actions
          button.btn(type="button" id="guardarPartidaBtn") Guardar partida
          a.btn.btn--ghost#volverLink(href=obraId ? `/obras/${obraId}` : "/obras") Volver al detalle

  script.
    let itemCount = 0;
    let modoEdicion = false;
    const obraId = document.getElementById('obraId').value;
    const partidaId = document.getElementById('partidaId').value;
    const itemsContainer = document.getElementById('itemsContainer');
    const emptyItems = document.getElementById('emptyItems');

    function actualizarEstadoVacio() {
      emptyItems.style.display = itemsContainer.children.length ? 'none' : 'block';
    }

    function itemTemplate(id, item = {}) {
      return `
        <div id="item-${id}" class="item-card">
          <div class="item-card__head">
            <h3>Item ${id}</h3>
            <button class="btn btn--small btn--danger" type="button" onclick="eliminarItem(${id})">Eliminar</button>
          </div>
          <div class="form-grid">
            <div class="field field--full">
              <label for="detalle-${id}">Detalle</label>
              <input id="detalle-${id}" type="text" class="detalle" value="${item.detalle || ''}" placeholder="Ej: Paneles SIP para envolvente" required>
            </div>
            <div class="field">
              <label for="unidad-${id}">Unidad de medida</label>
              <input id="unidad-${id}" type="text" class="unidad_medida" value="${item.unidad_medida || ''}" placeholder="Ej: m2, horas, unidades" required>
            </div>
            <div class="field">
              <label for="cantidad-${id}">Cantidad</label>
              <input id="cantidad-${id}" type="number" class="cantidad" value="${item.cantidad || ''}" placeholder="Ej: 20" min="0.01" step="0.01" required>
            </div>
            <div class="field">
              <label for="precio-${id}">Precio unitario</label>
              <input id="precio-${id}" type="number" class="precio_unitario" value="${item.precio_unitario || ''}" placeholder="Ej: 2500" min="0.01" step="0.01" required>
            </div>
          </div>
        </div>
      `;
    }

    function agregarItem(item) {
      itemCount++;
      itemsContainer.insertAdjacentHTML('beforeend', itemTemplate(itemCount, item));
      actualizarEstadoVacio();
    }

    function eliminarItem(id) {
      const elemento = document.getElementById(`item-${id}`);
      if (elemento) {
        elemento.remove();
        actualizarEstadoVacio();
      }
    }

    async function cargarPartidaParaEditar() {
      try {
        const response = await fetch(`/api/partidas/${partidaId}`);

        if (!response.ok) {
          throw new Error('Error al cargar la partida');
        }

        const partida = await response.json();

        document.getElementById('rubro').value = partida.rubro;
        document.getElementById('volverLink').href = `/obras/${partida.obra_id}`;

        partida.items.forEach((item) => agregarItem(item));
      } catch (error) {
        alert('Error al cargar la partida: ' + error.message);
        console.error('Error:', error);
      }
    }

    if (partidaId) {
      modoEdicion = true;
      document.getElementById('titulo').textContent = 'Editar partida presupuestaria';
      document.getElementById('descripcion').textContent = 'Actualice el rubro y sus items presupuestarios.';
      document.getElementById('guardarPartidaBtn').textContent = 'Actualizar partida';
      cargarPartidaParaEditar();
    }

    document.getElementById('agregarItemBtn').addEventListener('click', () => agregarItem());

    document.getElementById('guardarPartidaBtn').addEventListener('click', async function() {
      const rubro = document.getElementById('rubro').value;

      if (!rubro) {
        alert('Por favor selecciona un rubro');
        return;
      }

      const itemsDivs = document.querySelectorAll('[id^="item-"]');

      if (itemsDivs.length === 0) {
        alert('Es necesario agregar al menos un ítem');
        return;
      }

      const items = [];

      for (const div of itemsDivs) {
        const detalle = div.querySelector('.detalle').value.trim();
        const cantidad = parseFloat(div.querySelector('.cantidad').value);
        const unidad_medida = div.querySelector('.unidad_medida').value.trim();
        const precio_unitario = parseFloat(div.querySelector('.precio_unitario').value);

        if (!detalle || !cantidad || !unidad_medida || !precio_unitario) {
          alert('Todos los campos de los ítems son requeridos');
          return;
        }

        items.push({ detalle, cantidad, unidad_medida, precio_unitario });
      }

      const datosPartida = {
        obra_id: obraId,
        rubro,
        items
      };

      try {
        const response = await fetch(modoEdicion ? `/api/partidas/${partidaId}` : '/api/partidas', {
          method: modoEdicion ? 'PUT' : 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(datosPartida)
        });

        if (!response.ok) {
          const error = await response.json();
          throw new Error(error.message || 'Error en la operación');
        }

        alert(modoEdicion ? 'Partida presupuestaria actualizada correctamente' : 'Partida presupuestaria creada correctamente');
        window.location.href = `/obras/${obraId}`;
      } catch (error) {
        alert('Error: ' + error.message);
        console.error('Error:', error);
      }
    });

    actualizarEstadoVacio();
