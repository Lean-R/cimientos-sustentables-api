extends ../layout

block content
  .page-head
    div
      p.page-kicker Presupuesto de obra
      h1.page-title Cargar partidas presupuestarias
      p.page-lead Complete los 7 rubros para construir el presupuesto total calculado de la obra.
    .actions
      a.btn.btn--ghost(href=`/obras/${obraId}`) Volver al detalle

  .panel
    .panel__header
      div
        h2.panel__title Asistente de carga
        p.panel__text Avance rubro por rubro. Cada partida necesita al menos un ítem completo.
      span.tag.tag--ochre 7 pasos
    .panel__body
      .wizard-progress#progreso
        each paso, index in [1,2,3,4,5,6,7]
          .wizard-step.paso-indicador(data-paso=index)
            span= paso
            small Paso #{paso}/7

      .wizard-panel#pasoContainer
        .wizard-panel__head
          h2#rubroTitulo
          p#rubroDescripcion
        .item-list#itemsContainer
          .empty-state
            p Agregue los ítems de esta partida.
        .form-actions
          button.btn.btn--secondary(type="button" id="agregarItemBtn") + Agregar item

      .wizard-actions
        button.btn.btn--ghost(type="button" id="anteriorBtn") Anterior
        button.btn(type="button" id="siguienteBtn") Siguiente

  input#obraId(type="hidden" value=obraId)

  script.
    const obraId = document.getElementById('obraId').value;

    const RUBROS = [
      { id: 'trabajos_preliminares_y_gestion_verde', nombre: 'Trabajos preliminares y gestión verde', descripción: 'Gestión de permisos, estudios técnicos, ingeniería e infraestructura provisoria.' },
      { id: 'infraestructura_y_fundaciones', nombre: 'Infraestructura y fundaciones', descripción: 'Movimiento de suelos, hormigón, hierro, barrera de vapor y mano de obra.' },
      { id: 'envolvente_sustentable', nombre: 'Envolvente sustentable', descripción: 'Paneles SIP/Steel, fijaciones, hermeticidad, cubierta y montaje.' },
      { id: 'aberturas_de_alta_prestacion', nombre: 'Aberturas de alta prestación', descripción: 'Carpinteria PVC con RPT, vidrios DVH/TVH, puertas técnicas e instalación.' },
      { id: 'instalaciones_bio_eficientes', nombre: 'Instalaciones bio-eficientes', descripción: 'Climatización, sanitario y solar, eléctrica, domótica y mano de obra.' },
      { id: 'revestimientos_y_terminaciones', nombre: 'Revestimientos y terminaciones', descripción: 'Revestimientos exteriores, interiores, pinturas y mano de obra de acabados.' },
      { id: 'limpieza_y_entrega', nombre: 'Limpieza y entrega', descripción: 'Gestión de residuos y limpieza final de obra.' }
    ];

    let pasoActual = 0;
    let itemsPorPaso = Array(7).fill(null).map(() => []);

    const rubroTitulo = document.getElementById('rubroTitulo');
    const rubroDescripcion = document.getElementById('rubroDescripcion');
    const itemsContainer = document.getElementById('itemsContainer');
    const agregarItemBtn = document.getElementById('agregarItemBtn');
    const anteriorBtn = document.getElementById('anteriorBtn');
    const siguienteBtn = document.getElementById('siguienteBtn');
    const indicadores = document.querySelectorAll('.paso-indicador');

    function actualizarPaso() {
      const rubro = RUBROS[pasoActual];
      rubroTitulo.textContent = `Partida ${pasoActual + 1}/7: ${rubro.nombre}`;
      rubroDescripcion.textContent = rubro.descripcion;

      indicadores.forEach((el, i) => {
        el.classList.toggle('is-complete', i < pasoActual);
        el.classList.toggle('is-active', i === pasoActual);
      });

      anteriorBtn.style.visibility = pasoActual === 0 ? 'hidden' : 'visible';

      if (pasoActual === RUBROS.length - 1) {
        siguienteBtn.textContent = 'Guardar y finalizar';
      } else {
        siguienteBtn.textContent = 'Siguiente';
      }

      renderizarItems();
    }

    function renderizarItems() {
      const paso = pasoActual;
      const items = itemsPorPaso[paso];
      let html = '';

      if (items.length === 0) {
        html = '<div class="empty-state"><p>No hay ítems cargados en esta partida. Agregue un ítem para empezar.</p></div>';
      } else {
        items.forEach((item, index) => {
          html += `
            <div class="item-card wizard-item">
              <div class="item-card__head">
                <h3>Item ${index + 1}</h3>
                <button class="btn btn--small btn--danger" type="button" onclick="eliminarItemWizard(${index})">Eliminar</button>
              </div>
              <div class="form-grid">
                <div class="field field--full">
                  <label>Detalle</label>
                  <input type="text" class="w-detalle" value="${item.detalle}" placeholder="Ej: Paneles SIP para envolvente">
                </div>
                <div class="field">
                  <label>Unidad de medida</label>
                  <input type="text" class="w-unidad" value="${item.unidad_medida}" placeholder="Ej: horas, m2, unidades">
                </div>
                <div class="field">
                  <label>Cantidad</label>
                  <input type="number" class="w-cantidad" value="${item.cantidad}" placeholder="Ej: 20" min="1">
                </div>
                <div class="field">
                  <label>Precio unitario</label>
                  <input type="number" class="w-precio" value="${item.precio_unitario}" placeholder="Ej: 2500" min="0.01" step="0.01">
                </div>
              </div>
            </div>
          `;
        });
      }

      itemsContainer.innerHTML = html;
    }

    function guardarItemsActuales() {
      const paso = pasoActual;
      const divs = itemsContainer.querySelectorAll('.wizard-item');
      const items = [];

      divs.forEach(div => {
        const detalle = div.querySelector('.w-detalle')?.value?.trim();
        const unidad = div.querySelector('.w-unidad')?.value?.trim();
        const cantidadInput = div.querySelector('.w-cantidad');
        const precioInput = div.querySelector('.w-precio');
        const cantidad = cantidadInput ? parseFloat(cantidadInput.value) : null;
        const precio = precioInput ? parseFloat(precioInput.value) : null;

        if (detalle && unidad && cantidad && precio) {
          items.push({
            detalle,
            cantidad,
            unidad_medida: unidad,
            precio_unitario: precio
          });
        }
      });

      itemsPorPaso[paso] = items;
    }

    function eliminarItemWizard(index) {
      guardarItemsActuales();
      const paso = pasoActual;
      itemsPorPaso[paso].splice(index, 1);
      renderizarItems();
    }

    agregarItemBtn.addEventListener('click', () => {
      guardarItemsActuales();
      const paso = pasoActual;
      itemsPorPaso[paso].push({
        detalle: '',
        cantidad: '',
        unidad_medida: '',
        precio_unitario: ''
      });
      renderizarItems();
    });

    anteriorBtn.addEventListener('click', () => {
      guardarItemsActuales();
      if (pasoActual > 0) {
        pasoActual--;
        actualizarPaso();
      }
    });

    siguienteBtn.addEventListener('click', async () => {
      guardarItemsActuales();
      const paso = pasoActual;
      const items = itemsPorPaso[paso];

      if (items.length === 0) {
        alert(`Por favor, agregue al menos un ítem a la partida "${RUBROS[paso].nombre}"`);
        return;
      }

      for (let i = 0; i < items.length; i++) {
        const item = items[i];
        if (!item.detalle || !item.cantidad || !item.unidad_medida || !item.precio_unitario) {
          alert(`El item ${i + 1} de la partida "${RUBROS[paso].nombre}" tiene campos incompletos.`);
          return;
        }
      }

      if (paso === RUBROS.length - 1) {
        await guardarTodasLasPartidas();
      } else {
        pasoActual++;
        actualizarPaso();
      }
    });

    async function guardarTodasLasPartidas() {
      const btn = siguienteBtn;
      btn.disabled = true;
      btn.textContent = 'Guardando...';

      let exitos = 0;
      let errores = 0;

      for (let i = 0; i < RUBROS.length; i++) {
        const items = itemsPorPaso[i];

        if (items.length === 0) continue;

        const datos = {
          obra_id: obraId,
          rubro: RUBROS[i].id,
          items
        };

        try {
          const response = await fetch('/api/partidas', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(datos)
          });

          if (response.ok) {
            exitos++;
          } else {
            const err = await response.json();
            console.error(`Error en partida ${i + 1}:`, err);
            errores++;
          }
        } catch (error) {
          console.error(`Error al guardar partida ${i + 1}:`, error);
          errores++;
        }
      }

      if (exitos > 0) {
        alert(`Partidas guardadas correctamente (${exitos} creadas${errores > 0 ? `, ${errores} con error` : ''})`);
        window.location.href = `/obras/${obraId}`;
      } else {
        alert('Ocurrió un error al guardar las partidas. Revise la consola para más detalles.');
        btn.disabled = false;
        btn.textContent = 'Guardar y finalizar';
      }
    }

    actualizarPaso();
