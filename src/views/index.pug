extends layout

block content
  .login-card
    section.login-card__brand
      img.login-card__logo(src="/logo-cimientos.png" alt="Logo Cimientos Sustentables e Hijos SA")
      .login-card__copy
        h1.login-title
          span Gestión de
          span obras

    section.login-card__form
      h2 Inicio de sesión
      p Acceso interno para administración y dirección de obra.

      form.form(action="/login" method="POST")
        .field
          label(for="username") Usuario
          input#username(type="text" name="username" autocomplete="username" required)

        .field
          label(for="password") Contraseña
          input#password(type="password" name="password" autocomplete="current-password" required)

        .form-actions
          button.btn(type="submit") Entrar al sistema

        if error
          .login-error= error
