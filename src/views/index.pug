extends layout

block content
  - var pageTitle = "Iniciar sesion"
  - var hideShell = true
  - var bodyClass = "login-page"

  .login-card
    section.login-card__brand
      img.login-card__logo(src="/logo-cimientos.png" alt="Logo Cimientos Sustentables e Hijos SA")
      div
        p.page-kicker Sistema administrativo
        h1 Gestion de obras sustentables
      p Control de obras, partidas presupuestarias, solicitudes de materiales y gastos desde una interfaz clara para el equipo de obra.

    section.login-card__form
      h2 Iniciar sesion
      p Acceso interno para administracion y direccion de obra.

      form#loginForm.form
        .field
          label(for="username") Usuario
          input#username(type="text" name="username" autocomplete="username" required)

        .field
          label(for="password") Contrasena
          input#password(type="password" name="password" autocomplete="current-password" required)

        .form-actions
          button.btn(type="submit") Entrar al sistema

  script.
    document.getElementById('loginForm').addEventListener('submit', async (event) => {
      event.preventDefault();

      const username = document.getElementById('username').value;
      const password = document.getElementById('password').value;

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        if (response.ok) {
          window.location.href = '/obras';
        } else {
          alert('Credenciales incorrectas');
        }
      } catch (error) {
        alert('Credenciales incorrectas');
      }
    });
