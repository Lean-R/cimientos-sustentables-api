extends layout

block content
  .login-card
    section.login-card__brand
      img.login-card__logo(src="/logo-cimientos.png" alt="Logo Cimientos Sustentables e Hijos SA")
      .login-card__copy
        h1.login-title
          span Gestión de
          span obras

    section.login-card__form
      h2 Inicio de sesión
      p Acceso interno para administración y dirección de obra.

      form#loginForm.form
        .field
          label(for="username") Usuario
          input#username(type="text" name="username" autocomplete="username" required)

        .field
          label(for="password") Contraseña
          input#password(type="password" name="password" autocomplete="current-password" required)

        .form-actions
          button.btn(type="submit") Entrar al sistema

  script.
    document.getElementById('loginForm').addEventListener('submit', async (event) => {
      event.preventDefault();

      const username = document.getElementById('username').value;
      const password = document.getElementById('password').value;

      try {
        const response = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ username, password })
        });

        if (response.ok) {
          window.location.href = '/obras';
        } else {
          alert('Credenciales incorrectas');
        }
      } catch (error) {
        alert('Credenciales incorrectas');
      }
    });
