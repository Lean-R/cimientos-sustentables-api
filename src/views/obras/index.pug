extends ../layout

block content
  .page-head
    div
      p.page-kicker Administración de obras
      h1.page-title Listado de obras
      p.page-lead Consulte las obras cargadas, revise su estado y acceda al detalle operativo de cada proyecto.
    .actions
      a.btn(href="/obras/nueva") Nueva obra

  .panel
    .panel__header
      div
        h2.panel__title Obras registradas
        p.panel__text Datos generales y accesos de gestión.
      span.tag #{obras ? obras.length : 0} obras

    if obras && obras.length
      .table-wrap
        table.data-table
          thead
            tr
              th Nombre
              th Ubicación
              th Director de obra
              th Contratación
              th Estado
              th Acciones
          tbody
            each obra in obras
              tr
                td
                  strong= obra.nombre
                td
                  div= obra.direccion
                  small= obra.provincia
                td= obra.director
                td= obra.tipo_contratacion
                td
                  span.status-pill= obra.estado
                td
                  .actions
                    a.btn.btn--small(href=`/obras/${obra.id}`) Ver detalle
                    a.btn.btn--small.btn--secondary(href=`/obras/editar/${obra.id}`) Editar
                    a.btn.btn--small.btn--danger(href=`/obras/eliminar/${obra.id}` onclick="return confirm('¿Eliminar esta obra?')") Eliminar
    else
      .empty-state
        h2 Todavia no hay obras cargadas
        p Cree una obra para iniciar la carga de partidas presupuestarias.
