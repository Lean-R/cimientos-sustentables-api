doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= `Detalle de obra - ${obra.nombre}`

  body
    h1= obra.nombre

    h2 Datos generales

    p
      strong Nombre:
      |  #{obra.nombre}

    p
      strong Dirección:
      |  #{obra.direccion}

    p
      strong Provincia:
      |  #{obra.provincia}

    p
      strong Director de obra:
      |  #{obra.director}

    p
      strong Teléfono de contacto:
      |  #{obra.telefono}

    p
      strong Tipo de contratación:
      |  #{obra.tipo_contratacion}

    p
      strong Estado:
      |  #{obra.estado}

    hr

    h2 Presupuesto

    if tienePartidas
      p
        strong Presupuesto total:
        |  $#{totalPartidas.toLocaleString()}

      h3 Partidas presupuestarias
      each partida in partidas
        div(style="margin-bottom: 20px; padding: 10px; border: 1px solid #ddd;")
          p
            a(href=`/partidas/editar?partidaId=${partida.id}&obraId=${obra.id}`) Editar
            |  |
            a(href="#" onclick=`event.preventDefault(); eliminarPartida('${partida.id}')`) Eliminar
          p
            strong Rubro:
            |  #{partida.rubro}
          p
            strong Precio total:
            |  $#{Number(partida.precio_total).toLocaleString()}

          h4 Items:
          table(border="1" cellpadding="5" cellspacing="0")
            thead
              tr
                th Detalle
                th Cantidad
                th Unidad de medida
                th Precio unitario
                th Precio parcial
            tbody
              each item in partida.items
                tr
                  td= item.detalle
                  td= item.cantidad
                  td= item.unidad_medida
                  td $#{Number(item.precio_unitario).toLocaleString()}
                  td $#{Number(item.precio_parcial).toLocaleString()}

      hr

      h2 Gastos registrados

      if gastos.length > 0
        table(border="1" cellpadding="5" cellspacing="0" style="width: 100%; border-collapse: collapse; margin-top: 10px;")
          thead
            tr(style="background-color: #f2f2f2; text-align: left;")
              th Fecha
              th Partida
              th Concepto / Detalle
              th(style="text-align: center;") Cantidad
              th(style="text-align: center;") Unidad
              th Monto
              th Estado
          tbody
            each gasto in gastos
              tr
                td= gasto.fecha ? new Date(gasto.fecha).toLocaleDateString() : 'S/D'
                td= gasto.partidaRubro || 'Sin partida'
                td= gasto.concepto || 'Sin concepto'
                td(style="text-align: center;")= gasto.cantidad || 'N/A'
                td(style="text-align: center;")= gasto.unidad || 'N/A'
                td $#{Number(gasto.monto).toLocaleString()}
                td
                  span(style="padding: 2px 6px; border-radius: 4px; background: #eee; font-size: 0.85em;")= gasto.estado || 'Pendiente'
      else
        p No hay gastos registrados en esta obra.

      p
        strong Total gastos registrados:
        |  $#{totalGastos.toLocaleString()}

      hr

      p
        a(href=`/gastos/nuevo?obraId=${obra.id}`) + Registrar gasto
        |  |
        a(href=`/materiales/nueva-solicitud?obraId=${obra.id}`) + Solicitud de materiales

    else
      p
        strong Presupuesto total:
        |  Pendiente

      p Todavía no se cargaron las partidas presupuestarias.

      p
        a(href=`/partidas/cargar?obraId=${obra.id}` style="padding: 10px 20px; background: #4CAF50; color: white; text-decoration: none; border-radius: 4px; display: inline-block;") + Cargar partidas presupuestarias

    hr

    p
      a(href="/obras") Volver al listado

    script.
      async function eliminarPartida(partidaId) {
        const confirmar = confirm('¿Estás seguro de que deseás eliminar esta partida presupuestaria?');

        if (!confirmar) {
          return;
        }

        try {
          const response = await fetch(`/api/partidas/${partidaId}`, {
            method: 'DELETE'
          });

          if (!response.ok) {
            throw new Error('Error al eliminar la partida');
          }

          alert('¡Partida eliminada correctamente!');
          location.reload();
        } catch (error) {
          alert('Error: ' + error.message);
          console.error('Error:', error);
        }
      }
