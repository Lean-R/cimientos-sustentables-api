doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title Nuevo gasto

  body
    h1#titulo Nuevo gasto
    p#descripcion Completá los datos para registrar un gasto.

    form#formGasto
      input(type="hidden" id="obra_id" name="obra_id" value=obraId)

      br

      div
        label(for="partida_id") Partida Presupuestaria:
        select(id="partida_id" name="partida_id")
          option(value="") Cargando partidas...

      br

      div
        label(for="fecha") Fecha:
        input(type="date" id="fecha" name="fecha" value=(new Date().toISOString().split('T')[0]))

      br

      div
        label(for="concepto") Concepto / Detalle corto:
        input(type="text" id="concepto" name="concepto" placeholder="Ej: Compra de tirantes de madera certificada")

      br

      div
        label(for="cantidad") Cantidad:
        input(type="number" id="cantidad" name="cantidad" step="1" min="1")

      br

      div
        label(for="unidad") Unidad de medida:
        select(id="unidad" name="unidad")
          option(value="") Seleccionar unidad
          option(value="unidades") Unidades
          option(value="litros") Litros(L)
          option(value="kilos") Kilos(Kg)
          option(value="metros") Metros(m)
          option(value="m2") Metros cuadrados(m²)
          option(value="m3") Metros cúbicos(m³)

      br

      div
        label(for="monto") Monto Estimado:
        input(type="number" id="monto" name="monto" step="0.01" min="0.01" placeholder="(Estimado)")

      br

      button(type="submit" id="guardarGasto") Guardar gasto

      br
      br

      if obraId
        a(href=`/obras/${obraId}`) Volver al detalle de la obra
      else
        a(href="/obras") Volver al listado de obras

  script(src="/js/gastos.js")
  script.
    // Cargar partidas reales de la obra al iniciar
    (async function cargarPartidas() {
      const select = document.getElementById('partida_id');
      const obraId = document.getElementById('obra_id').value;

      try {
        const response = await fetch(`/api/partidas?obra_id=${obraId}`);
        if (!response.ok) throw new Error('Error al cargar partidas');

        const partidas = await response.json();

        if (partidas.length === 0) {
          select.innerHTML = '<option value="">No hay partidas cargadas</option>';
          return;
        }

        const RUBROS_NOMBRES = {
          trabajos_preliminares_y_gestion_verde: 'Trabajos preliminares y gestión verde',
          infraestructura_y_fundaciones: 'Infraestructura y fundaciones',
          envolvente_sustentable: 'Envolvente sustentable',
          aberturas_de_alta_prestacion: 'Aberturas de alta prestación',
          instalaciones_bio_eficientes: 'Instalaciones Bio-eficientes',
          revestimientos_y_terminaciones: 'Revestimientos y Terminaciones',
          limpieza_y_entrega: 'Limpieza y Entrega'
        };

        select.innerHTML = '<option value="">Seleccionar partida</option>';
        partidas.forEach(p => {
          const label = RUBROS_NOMBRES[p.rubro] || p.rubro;
          select.innerHTML += `<option value="${p.id}">${label} - $${Number(p.precio_total).toLocaleString()}</option>`;
        });
      } catch (error) {
        console.error('Error al cargar partidas:', error);
        select.innerHTML = '<option value="">Error al cargar partidas</option>';
      }
    })();
